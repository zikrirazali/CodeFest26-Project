# Copy to backend/.env and adjust. Every value has a safe local default.

# PostgreSQL (production). Leave unset to use a local SQLite file.
# DATABASE_URL=postgresql+psycopg://tempa:tempa@localhost:5432/tempa

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
LEDGER_SECRET=change-me-too
JWT_TTL_MINUTES=720

# Load the bilingual demo course, students and squads on first start.
SEED_DEMO=true

# Optional: enables the AI coach (Claude) for referee hints. Without it, rule-based hints are used.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Tuning
READING_WPM=230
MIN_DWELL_SECONDS=6
CLAIM_TTL_HOURS=72
MAX_ACTIVE_CLAIMS=2
SANDBOX_TIMEOUT_SECONDS=4
